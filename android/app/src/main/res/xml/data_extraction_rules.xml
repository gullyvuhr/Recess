<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <!-- app_flutter is dedicated to recess.sqlite and its possible SQLite sidecars. -->
        <include domain="root" path="app_flutter" />

        <!-- Native notification schedules are transient and rebuilt from the database. -->
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="sharedpref" path="notification_plugin_cache.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" path="app_flutter" />
        <exclude domain="sharedpref" path="scheduled_notifications.xml" />
        <exclude domain="sharedpref" path="notification_plugin_cache.xml" />
    </device-transfer>
</data-extraction-rules>
